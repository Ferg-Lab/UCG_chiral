variable        steps index 100

units           lj
newton          off
atom_style      chiral
boundary        p p p
#########################################################
neighbor        1.5 bin
neigh_modify    delay 0 every 1 check yes
pair_style      table/ucg/chirality lookup 100000 state.conf
#pair_style      lj/cut 5
read_data       ucg_initialconfig_ee_zero.dat
#########################################################
pair_coeff      1 1 Pair_L-L.table L-L
pair_coeff      2 2 Pair_D-D.table D-D
pair_coeff      1 2 Pair_L-L.table L-L
pair_modify     shift yes
#pair_modify     mix arithmetic
#pair_coeff      1 1 1 .5 5.0
#pair_coeff      2 2 2 .5 5.0
#########################################################
variable	    NLOG equal 10
#variable        DTIME equal 0.0005 #0.001 #1
variable        DTIME equal 0.002
variable        DTSTAT equal 100*v_DTIME
variable        T equal 4.6
#########################################################
timestep        ${DTIME}
thermo          ${NLOG}
thermo_style    custom step temp press density pe ke etotal
#log             UCG_log.lammps
###########SET TEMPERATURE################################
velocity        all create ${T} 7238765 mom yes rot yes dist gaussian
fix mom1        all momentum 100 linear 1 1 1 #angular 
##########################################################
compute 	compute_chirality all property/atom chirality
dump 		dump_1 all custom ${NLOG} UCG_chiral.lammpstrj id type x y z fx fy fz c_compute_chirality
dump_modify 	dump_1 sort id
##########################################################
#fix             1 all nvt temp ${T} ${T} ${DTSTAT}
# Integrator: microcanonical ensemble (no thermostat/barostat)
fix             int all nve

variable nevery          index 200
variable threshold_radii index 3.0
variable a               index 4.645
variable b               index 0.5
variable c               index 1.0
variable seed            index 847144
variable cv_mode         index 1
variable distcut         index 4.0
variable first_nelements index 12
variable maxiter         index 1

#fix             evolve_chirality all update/chirality 200 3.0 4.645 0.5 1.0 42 0 4.0 12 1

fix             evolve_chirality all update/chirality ${nevery} ${threshold_radii} $a $b $c ${seed} ${cv_mode} ${distcut} ${first_nelements} ${maxiter}

##########################################################
#restart         50000 ucg.restart
run             ${steps} #200000000 #post no
##########################################################
#write_restart   UCG_tetramer.restart
#write_data      UCG_tetramer.data
##########################################################
